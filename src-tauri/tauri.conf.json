{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timer",
  "version": "0.1.1",
  "identifier": "com.dimsedra.timer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Timer",
        "width": 360,
        "height": 420,
        "minWidth": 260,
        "minHeight": 110,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQzAyMjdFN0UyQjVEMgpSV1RTdGVMbkp3SWNDOVdkTFBVRHlxcUVwU1Bjb0tsMW9DK1N5eGltcFM0Mmp3YVhpb0xQQ1RDNwo=",
      "endpoints": [
        "https://github.com/dimsedra/timer-app/releases/latest/download/latest.json"
      ]
    }
  }
}
